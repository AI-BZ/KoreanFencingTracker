# =============================================
# FencingMind Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ===== Shared Core =====
JWT_SECRET_KEY=your-jwt-secret-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ===== Account Service (port 70) =====
COOKIE_DOMAIN=.fencingmind.ai
ACCOUNT_SERVICE_URL=https://account.fencingmind.ai

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://account.fencingmind.ai/auth/callback/kakao

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://account.fencingmind.ai/auth/callback/google

# OAuth - X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://account.fencingmind.ai/auth/callback/x

# Gemini (본인인증)
GEMINI_API_KEY=
VERIFICATION_AUTO_APPROVE_THRESHOLD=0.85
VERIFICATION_AUTO_REJECT_THRESHOLD=0.3

# IP Geolocation
IP_GEOLOCATION_API_KEY=

# ===== Data Service (port 71) =====
SCRAPE_DELAY=1.0
MAX_CONCURRENT_REQUESTS=3
MAX_RETRIES=3

# ===== Scheduler =====
DAILY_SYNC_HOUR=6
HOURLY_UPDATE_ENABLED=true

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Supabase MCP Server =====
# Supabase 관리 토큰. .mcp.json이 ${SUPABASE_ACCESS_TOKEN}로 참조하며,
# 이 치환은 .env가 아니라 "셸 환경변수"를 읽는다. 따라서 실제 값은 ~/.zshrc 등에
# `export SUPABASE_ACCESS_TOKEN=...` 로 설정해야 Supabase MCP가 동작한다.
# SUPABASE_ACCESS_TOKEN=sbp_xxx  (셸 환경변수로 export, .env에 두면 MCP는 못 읽음)
