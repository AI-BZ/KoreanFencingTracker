# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Scraper Configuration
SCRAPE_DELAY=1.0
MAX_CONCURRENT_REQUESTS=3
MAX_RETRIES=3

# Scheduler Configuration
DAILY_SYNC_HOUR=6
HOURLY_UPDATE_ENABLED=true

# OAuth - Kakao (https://developers.kakao.com)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:71/auth/callback/kakao

# OAuth - Google (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:71/auth/callback/google

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key

# Cookie (set for production)
# COOKIE_DOMAIN=.fencingmind.ai

# Logging
LOG_LEVEL=INFO
